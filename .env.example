# Copy: cp .env.example .env  rồi điền secret thật.
# Docker Compose đọc .env ở thư mục ast/ (cùng docker-compose.yml).

REPO_UPLOADS_DIR=/app/temp_uploads
GITNEXUS_SERVE_BASE_URL=http://gitnexus:4747
GITNEXUS_USE_NPX=1

SUPABASE_DB_USER=
SUPABASE_PASSWORD=
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=6543
SUPABASE_DB_NAME=postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres

OPENAI_API_KEY=
OPENAI_BASE_URL=https://ckey.vn/v1
OPENAI_MODEL=qwen3-coder-next
LLM_TIMEOUT_SECONDS=180

# Local dev: để trống (tự tìm ast/cwe_dictionary.json). Docker: compose set /app/cwe_dictionary.json
CWE_DICTIONARY_PATH=
SCAN_MODEL_PATH=
SCAN_LAYER3_PROMPT_DUMP=0

# Express orchestration API
PORT=5000
PYTHON_API_URL=http://localhost:8000
PYTHON_HTTP_TIMEOUT_MS=5400000
SCAN_LAYER3_LIMIT=999
JWT_SECRET=
MONGO_URI=
NEON_DB_URL=

# Optional integrations used by the Express API
OPENROUTER_API_KEY=
GROQ_API_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_KEY=
URLSCAN_API_KEY=
ABUSEIPDB_API_KEY=
CHECKPHISH_API_KEY=
